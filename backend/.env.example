SECRET_KEY=replace-with-a-random-django-secret-key
DEBUG=True

# Use SQLite by default to keep the project zero-config. Switch to PostgreSQL in production.
# DATABASE_URL=postgresql://mobilehub_user:yourpassword@localhost:5432/mobilehub
USE_SQLITE=True

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

YOUTUBE_API_KEY=

# --- Email (password reset) ---------------------------------------------------
# To send real password-reset emails to a Gmail account, set EMAIL_BACKEND=gmail
# (or "django.core.mail.backends.smtp.EmailBackend") and fill in the next four
# values. EMAIL_HOST_PASSWORD must be a Gmail *App Password*, NOT your account
# password. Generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be enabled on the account).
#
# If you leave these blank, Django falls back to the console backend and prints
# the reset link to the runserver log — handy for offline development, useless
# for real users.
EMAIL_BACKEND=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Payment simulator -------------------------------------------------------------
# Origin of the MobileHub hub (where /orders/<n> lives). The bKash/Nagad simulator
# uses this to redirect the customer back to their order after a hosted-page
# approval. Override in production to your public hub origin (e.g. https://hub.example.com).
HUB_BASE_URL=http://127.0.0.1:8000

# Point both gateways at the local simulator on port 8001. The provider
# adapters in apps/payments append the versioned path segments
# (/tokenized/checkout/... for bKash, /remote-payment-gateway-1.0/...
# for Nagad). To switch back to the real bKash/Nagad sandboxes, comment
# these out so the provider defaults to the production sandbox URLs.
BKASH_BASE_URL=http://127.0.0.1:8001/sim/bkash
NAGAD_BASE_URL=http://127.0.0.1:8001/sim/nagad
